# Required: signs access and refresh tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me

# One-time bootstrap: when no user exists yet, the first login with these
# credentials creates the admin account. Remove both after the first sign-in.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Optional: where uploaded books, covers and the index are stored.
# Defaults to ./.data inside the app.
# WEB_LIBRIS_DATA_DIR=./.data
